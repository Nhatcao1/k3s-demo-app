C4Container
title HE Looming SDK - Simplified Runtime and Capability View

Person(consumer, "SDK Consumer", "Application, script, service, worker, or notebook")
Person(recipient, "Result Recipient", "Optional holder of a separate result-decryption key")

System_Boundary(sdk_family, "HE Looming SDK - choose one runtime per Python process") {
    Container(cpu_runtime, "CPU SDK Runtime", "he_looming_sdk[cpu] + stock OpenFHE", "HESession provides encrypt/decrypt and the HE functions ADD, SUBTRACT, MULTIPLY, SQUARE, SUM, MEAN, and VARIANCE. CPU also supports workspace creation/reuse and the trial aggregate-result PRE flow.")

    Container(gpu_runtime, "GPU SDK Runtime", "he_looming_sdk core + he-sdk-fides + FIDESlib + patched OpenFHE + CUDA", "HESession exposes the same seven HE functions on NVIDIA GPU. Trusted local mode supports encrypt/decrypt. Compute-only mode can use an existing compatible workspace. Local FIDES persistence and PRE are not implemented.")

    ContainerDb(sdk_workspace, "Encrypted SDK Workspace", "Versioned filesystem artifacts", "Stores configuration, public/evaluation keys, metadata, and ciphertexts. It contains no plaintext or decryption key.")
}

Rel(consumer, cpu_runtime, "Uses CPU runtime", "HESession(device='cpu')")
Rel(consumer, gpu_runtime, "Or uses GPU runtime", "HESession(device='gpu')")

Rel(cpu_runtime, sdk_workspace, "Creates, saves, loads, and computes with")
Rel(gpu_runtime, sdk_workspace, "Computes with an existing workspace", "Compute-only mode")

Rel(recipient, cpu_runtime, "Provides recipient public key", "Optional PRE flow")
Rel(cpu_runtime, recipient, "Releases an already-calculated encrypted sum, mean, or variance")

UpdateElementStyle(cpu_runtime, $bgColor="#d9edf7", $borderColor="#2980b9")
UpdateElementStyle(gpu_runtime, $bgColor="#dff0d8", $borderColor="#3c763d")
