flowchart LR
    USER["SDK Consumer<br/><b>Application, script, service, worker or notebook</b>"]

    subgraph SDK_CORE["he_looming_sdk — shared Python SDK"]
        API["Public API<br/><b>he_sdk/__init__.py</b><br/><br/>HESession, CKKSConfig,<br/>encrypted values, capabilities<br/>and result-release types"]

        SESSION["HESession + HE Calculation Functions<br/><b>he_sdk/session.py</b><br/><br/>ENCRYPT · DECRYPT<br/>ADD · SUBTRACT · MULTIPLY · SQUARE<br/>SUM · MEAN · VARIANCE"]

        CONFIG["Configuration + Operation Contracts<br/><b>config.py · contracts.py</b><br/><br/>Session CKKS profile, depth cost,<br/>required keys and capabilities"]

        VALUES["Encrypted Values + Metadata<br/><b>ciphertext.py</b><br/><br/>Context, key bundle, shape,<br/>level, scale and provenance"]

        BACKEND["Backend Interface + Runtime Guard<br/><b>backends/base.py · native_runtime.py</b><br/><br/>Choose exactly one CPU or GPU runtime<br/>No automatic fallback"]

        WORKSPACE_MANAGER["CPU Workspace Management<br/><b>artifacts.py</b><br/><br/>Save/load encrypted artifacts<br/>No plaintext or secret key"]

        RELEASE_MANAGER["Aggregate Result Release<br/><b>result_release.py · release_artifacts.py</b><br/><br/>Post-calculation policy + PRE<br/>SUM · MEAN · VARIANCE only"]

        API --> SESSION
        CONFIG --> SESSION
        SESSION <--> VALUES
        SESSION -->|"Dispatch HE calculation"| BACKEND
    end

    subgraph CPU_RUNTIME["CPU Python environment / image"]
        CPU_ADAPTER["OpenFHE CPU Adapter<br/><b>backends/openfhe.py</b><br/><br/>Create context and keys<br/>Encrypt/decrypt + all seven functions<br/>Workspace persistence + PRE"]

        CPU_NATIVE["Stock OpenFHE Native Runtime<br/><b>CPU CKKS engine</b>"]

        CPU_ADAPTER --> CPU_NATIVE
    end

    subgraph GPU_RUNTIME["GPU Python environment / image"]
        GPU_ADAPTER["FIDES GPU Adapter<br/><b>he-sdk-fides</b><br/><br/>Create context and keys<br/>Encrypt/decrypt + all seven functions"]

        GPU_BINDING["FIDES Native Python Binding<br/><b>pybind11 / C++</b>"]

        GPU_NATIVE["FIDESlib + patched OpenFHE<br/><b>CUDA / NVIDIA GPU</b>"]

        GPU_LIMITS["Current GPU limitations<br/><br/>No local workspace persistence<br/>No proxy re-encryption"]

        GPU_ADAPTER --> GPU_BINDING
        GPU_BINDING --> GPU_NATIVE
        GPU_ADAPTER -.-> GPU_LIMITS
    end

    WORKSPACE[("Encrypted SDK Workspace<br/><br/>Configuration, public/evaluation keys,<br/>metadata and ciphertexts<br/><b>No plaintext or decryption key</b>")]

    RECIPIENT["Result Recipient<br/><br/>Own public and secret key"]

    USER -->|"Import SDK"| API

    BACKEND -->|"CPU runtime choice"| CPU_ADAPTER
    BACKEND -->|"GPU runtime choice"| GPU_ADAPTER

    SESSION -->|"CPU save/load"| WORKSPACE_MANAGER
    WORKSPACE_MANAGER --> CPU_ADAPTER
    WORKSPACE_MANAGER <--> WORKSPACE

    SESSION -->|"Already-calculated CPU aggregate"| RELEASE_MANAGER
    RELEASE_MANAGER -->|"Use OpenFHE PRE"| CPU_ADAPTER
    RECIPIENT -->|"Recipient public key"| RELEASE_MANAGER
    RELEASE_MANAGER -->|"Released encrypted result"| RECIPIENT

    classDef calculation fill:#fff3cd,stroke:#d39e00,stroke-width:3px,color:#1f1f1f
    classDef cpu fill:#d9edf7,stroke:#2980b9,stroke-width:2px,color:#1f1f1f
    classDef gpu fill:#dff0d8,stroke:#3c763d,stroke-width:2px,color:#1f1f1f
    classDef limitation fill:#f2dede,stroke:#a94442,stroke-width:1px,color:#1f1f1f

    class SESSION calculation
    class CPU_ADAPTER,CPU_NATIVE cpu
    class GPU_ADAPTER,GPU_BINDING,GPU_NATIVE gpu
    class GPU_LIMITS limitation
