C4Component
title HE Looming SDK - Package, Component, and Capability View

Container_Boundary(python_process, "One Consumer Python Process - exactly one native HE runtime active") {
    Component(consumer_code, "Consumer Code", "Application, script, notebook, service, or worker", "Chooses a CPU or GPU runtime and calls the backend-neutral SDK API.")

    Boundary(core_package, "he_looming_sdk distribution / he_sdk Python package") {
        Component(public_api, "Public API", "he_sdk/__init__.py", "Exports HESession, CKKSConfig, encrypted values, capabilities, errors, workspace types, and result-release types.")

        Component(session, "HESession Orchestration", "he_sdk/session.py", "Owns one HE context and backend. Provides create/open_workspace, encrypt/decrypt, add, subtract, multiply, square, sum, mean, variance, save/load, result release, compatibility checks, depth checks, and lifecycle management.")

        Component(config, "Session-level CKKS Configuration", "he_sdk/config.py - CKKSConfig", "Defines one shared CKKS profile for the session: security level, ring dimension, batch size, multiplicative depth, moduli, scaling, key-generation flags, and serialization version.")

        Component(contracts, "Operation Contracts and Capabilities", "he_sdk/contracts.py", "Defines operation inputs and outputs, depth cost, multiplication/rotation-key requirements, chunk policy, and the CapabilitySet reported by each backend.")

        Component(encrypted_values, "Encrypted Value and Metadata Model", "he_sdk/ciphertext.py", "Wraps opaque backend handles as EncryptedVector or EncryptedScalar and tracks context, key bundle, backend identity, logical shape, valid count, level, scale, checksum, and result provenance.")

        Component(backend_boundary, "Backend Protocol, Factory, and Runtime Guard", "he_sdk/backends/base.py and he_sdk/native_runtime.py", "Resolves cpu/openfhe or gpu/fides, creates trusted or compute-only backends, prevents incompatible native runtimes from sharing one process, and does not perform automatic CPU/GPU fallback.")

        Component(openfhe_adapter, "OpenFHE CPU Adapter", "he_sdk/backends/openfhe.py", "Implements trusted and compute-only CPU execution, CKKS operations, public/evaluation material export, ciphertext serialization, workspace reuse, and the trial proxy re-encryption capability.")

        Component(artifact_workspace, "Workspace and Artifact Management", "he_sdk/artifacts.py", "Creates and validates secretless versioned workspaces; saves, loads, checksums, indexes, serializes, and reconstructs compatible encrypted artifacts through the selected backend.")

        Component(result_release, "Result Release Policy and Artifacts", "he_sdk/result_release.py and he_sdk/release_artifacts.py", "Models recipient keys and released ciphertexts. Allows the current OpenFHE PRE trial to release only approved aggregate results: sum, mean, and variance.")
    }

    Boundary(gpu_package, "Optional he-sdk-fides GPU package") {
        Component(fides_adapter, "FIDES GPU Adapter", "gpu/he_sdk_fides/src/he_sdk_fides/backend.py", "Implements trusted local GPU encrypt/decrypt and HE operations through the native binding. Its compute-only mode opens existing OpenFHE-compatible public material and ciphertexts through the FIDES worker. Local serialization and PRE are not implemented.")

        Component(fides_binding, "FIDES Native Python Binding", "gpu/he_sdk_fides/native/bindings.cpp", "Creates the local FIDES context and keys, wraps native ciphertexts, and exposes encrypt, decrypt, arithmetic, reductions, and close to Python.")

        Component(fides_worker, "FIDES Workspace Worker", "gpu/worker/src/fides_backend.cpp and worker CLI", "Executes secretless operations on serialized OpenFHE-compatible artifacts with public and evaluation keys; it never receives a secret key.")
    }
}

System_Ext(openfhe_runtime, "Stock OpenFHE Native Runtime", "CPU CKKS engine loaded by the OpenFHE adapter; must not share a process with the FIDES patched OpenFHE runtime.")

System_Ext(fides_runtime, "FIDESlib Native Runtime", "CUDA plus FIDESlib and its patched OpenFHE build; executes CKKS operations on NVIDIA GPU.")

ContainerDb(sdk_workspace, "Secretless SDK Workspace", "Filesystem artifact format", "Contains manifest, CKKS configuration, public and evaluation material, and ciphertexts. Contains no plaintext or secret key.")

Person_Ext(recipient, "Result Recipient", "Optional holder of a separate key pair that can decrypt only explicitly released aggregate results")

